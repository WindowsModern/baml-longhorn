<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ILSpy plugin layout.

    net10.0-windows, matching ILSpy 10.1.0.8386 itself. The contracts reference
    System.Runtime 10.0, and the compiler enforces CS1705 on that, so targeting net9.0 was
    not possible; net10.0-windows is both required and correct.

    ILSpyBinDir points at an ILSpy installation whose DLLs supply the plugin contracts. Set it
    on the command line or in the environment:

      dotnet build -c Release -p:ILSpyBinDir="C:\path\to\ILSpy"
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>LonghornBaml</AssemblyName>
    <RootNamespace>LonghornBaml</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!--
      Assembly attributes come from the core library's Properties\AssemblyInfo.cs, which is
      compiled in with the rest of the decoder, so the SDK must not generate a second set. The
      two sets are not even the same attributes (the core declares AssemblyTitle and
      AssemblyCulture, the generator declares AssemblyCompany and AssemblyProduct), which is why
      the collision reports as CS0579 across several different attribute names.
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>baml-longhorn</Company>
    <Product>LonghornBaml</Product>
    <Description>Reads Windows Longhorn / pre-release Avalon BAML inside ILSpy. Distinct from the official WPF BAML plugin, which targets released WPF BAML only.</Description>
    <!-- MSB3277: referencing net10 contracts from an older target unifies upward at run time. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ILSpyBinDir Condition="'$(ILSpyBinDir)' == ''"></ILSpyBinDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <!--
      The core library carries assembly-level attributes in Properties\AssemblyInfo.cs, which
      collide with the ones this SDK project generates (CS0579). Getting this wrong is easy:
      the first attempt excluded '..\BamlLonghorn\AssemblyInfo.cs', one level too high, so the
      exclude silently did nothing and the build kept reporting duplicate attributes. The path
      was taken from the compiler's own file list rather than assumed.
    -->
    <Compile Remove="..\BamlLonghorn\Properties\AssemblyInfo.cs" />
    <!--
      The decoder core is compiled into the plugin rather than referenced.

      The core library targets .NET Framework 4.5, which a net10.0 plugin cannot reference.
      All 24 of its source files were checked and none uses Windows Forms, the registry,
      System.Drawing or any other Windows-only API: it is pure byte parsing and string
      building. Compiling the same sources here therefore costs nothing and avoids a second
      project, a project reference and a matching target framework on both sides.

      Keeping one set of sources rather than forking them means the CLI, the GUI and this
      plugin can never disagree about how a stream is decoded.
    -->
    <Compile Include="..\BamlLonghorn\**\*.cs"
             Exclude="..\BamlLonghorn\obj\**\*.cs;..\BamlLonghorn\bin\**\*.cs;..\BamlLonghorn\AssemblyInfo.cs;..\BamlLonghorn\.NETFramework*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ILSpy">
      <HintPath>$(ILSpyBinDir)\ILSpy.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ICSharpCode.ILSpyX">
      <HintPath>$(ILSpyBinDir)\ICSharpCode.ILSpyX.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ICSharpCode.Decompiler">
      <HintPath>$(ILSpyBinDir)\ICSharpCode.Decompiler.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      ExportAttribute comes from System.Composition.AttributedModel, not from
      System.ComponentModel.Composition. This was read out of the shipped BAML plugin's own
      reference list rather than assumed: the two MEF flavours both define an ExportAttribute,
      and choosing the wrong one yields an attribute that compiles and is then never discovered.
    -->
    <Reference Include="System.Composition.AttributedModel">
      <HintPath>$(ILSpyBinDir)\System.Composition.AttributedModel.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckILSpyBinDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(ILSpyBinDir)' == ''"
           Text="Set ILSpyBinDir to an ILSpy installation folder, e.g. -p:ILSpyBinDir=&quot;C:\Tools\ILSpy&quot;." />
    <Error Condition="!Exists('$(ILSpyBinDir)\ILSpy.dll')"
           Text="ILSpy.dll not found under ILSpyBinDir='$(ILSpyBinDir)'." />
  </Target>

</Project>
