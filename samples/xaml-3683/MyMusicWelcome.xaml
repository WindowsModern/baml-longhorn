            ShellViewBar:ImageResource.URI="res://Microsoft.Windows.Client/LocalResources/MusicIntro" ShellViewBar:ImageResource.SizingMode="2"/>
    <Element CanvasPresenter.Top="10%" CanvasPresenter.Left="30%" Presentation.Presenter="ShellViewBar:ImageResourcePresenter"
            ShellViewBar:ImageResource.URI="res://Microsoft.Windows.Client/LocalResources/MusicText" ShellViewBar:ImageResource.SizingMode="2"/>
    <Element CanvasPresenter.Top="50%" CanvasPresenter.Left="30%" Presentation.Presenter="ShellViewBar:ImageResourcePresenter"
            ShellViewBar:ImageResource.URI="res://Microsoft.Windows.Client/LocalResources/MusicIcons" ShellViewBar:ImageResource.SizingMode="2"/>
    <Element CanvasPresenter.Top="50%" CanvasPresenter.Left="30%" Presentation.Presenter="ShellViewBar:ImageResourcePresenter"
            ShellViewBar:ImageResource.URI="res://Microsoft.Windows.Client/LocalResources/MusicIconText" ShellViewBar:ImageResource.SizingMode="2"/>
