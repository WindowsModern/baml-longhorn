<Canvas ID="SplitterHover"
  xmlns="using:System.Windows;System.Windows.Controls;System.Windows.Documents;System.Windows.Shapes;System.Windows.Media;System.Windows.Presenters"
  Dock="Top" Width="100%" Height="100%" Background="#FFFFFF" Visibility="Collapsed">
    <DockPanel Left="5%" Width="90%" Height="100%">
        <Canvas Height="50%" Dock="Top" Background="VerticalGradient #00E66C00 #80E66C00" />
        <Canvas Height="50%" Dock="Top" Background="VerticalGradient #80E66C00 #00E66C00" />
    </DockPanel>
    <DockPanel Left="5%" Width="90%" Height="100%">
        <Canvas Width="50%" Dock="Left" Background="HorizontalGradient #FFFFFFFF #00FFFFFF" />
        <Canvas Width="50%" Dock="Left" Background="HorizontalGradient #00FFFFFF #FFFFFFFF" />
    </DockPanel>
</Canvas>

