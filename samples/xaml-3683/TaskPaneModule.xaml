<SVEnhancements:TaskPaneModule
  xmlns="using:System.Windows;System.Windows.Controls;System.Windows.Documents;System.Windows.Media;System.Windows.Presenters"
  xmlns:SVEnhancements="using:Microsoft.Windows.Client.Shell#Microsoft.Windows.Client.Shell.Experiences.Enhancements"
  xmlns:SVControls="using:ShellInterop#Microsoft.Windows.Client.Shell.View.Controls"
  Presentation.Presenter="DockPresenter"
  Background="#FF00FF"
  Margin="8,8,8,8"
  Dock="Top">

    <SVControls:GCButton ID="Header"
      Presentation.Presenter="DockPresenter"
      DockPanel.BoxStretch="None"
      Dock="Top">
        <PropertySheet>
            Text
            {
                FontFamily="Franklin Gothic Book"
                FontSize="12pt"
                Foreground="#629EE7"
            }
        </PropertySheet>
        <Image ID="Icon" Dock="Left" VerticalAlign="Center" DockPresenter.BoxStretch="None" />
        <Text ID="Text" Dock="Fill" VerticalAlign="Center" DockPresenter.BoxStretch="None" Margin="8,0,0,0" />
    </SVControls:GCButton>

    <DockPanel ID="Content" Background="#000000" Margin="0,8,0,0" Dock="Top">
        <PropertySheet>
            Text
            {
                FontFamily="Franklin Gothic Book"
                FontSize="8.63pt"
                Foreground="#848484"
            }
        </PropertySheet>
    </DockPanel>

</SVEnhancements:TaskPaneModule>
