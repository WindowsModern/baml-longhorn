# Line endings and binary handling.
#
# The published tree is stored with LF endings, and this working copy is on Windows where the
# default is to convert on checkout. Without declaring the intent, git warns on almost every text
# file and -- more importantly -- a file that round-trips through a CRLF conversion has different
# content, hence a different blob hash, hence a spurious diff against what is already published.
# Declaring LF keeps the local repository byte-comparable with the remote.

* text=auto eol=lf

# Fixtures and generated artefacts must never be line-ending converted, or they stop being the
# bytes the decompiler is supposed to read.
*.baml  binary
*.xaml  text eol=lf
*.resx  text eol=lf
*.dll   binary
*.exe   binary
*.pdb   binary
*.zip   binary

# Documentation and sources: LF, as everywhere else in this project.
*.md    text eol=lf
*.cs    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.csproj text eol=lf
*.sln   text eol=lf
